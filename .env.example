# Copy this file to `.env`. It holds ONLY non-secret pointers — never API keys.
# Secrets live in Azure Key Vault and are fetched at runtime via
# DefaultAzureCredential, so run `az login` first. The real .env is gitignored.

# Key Vault holding the backend API keys
# (secrets: `gemini-api-key`, `azure-openai-image-key`).
KEY_VAULT_NAME=your-key-vault-name

# Azure Foundry image backend (gpt-image).
AZURE_OPENAI_IMAGE_ENDPOINT=https://<your-account>.openai.azure.com/
AZURE_OPENAI_IMAGE_DEPLOYMENT=gpt-image-1
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Optional overrides for CI / offline use — set a key here to bypass Key Vault:
# GEMINI_API_KEY=
# AZURE_OPENAI_IMAGE_KEY=

# Output store — a durable (OneDrive-synced) folder for filed deliverables, plus the
# https base that exposes the same folder (SharePoint) so board links are clickable.
OUTPUT_STORE_ROOT=C:\path\to\OneDrive\Sequitur Studios\output
OUTPUT_STORE_URL_BASE=https://<tenant>-my.sharepoint.com/personal/<user>/Documents/Sequitur%20Studios/output
